# Copy to .env.local and fill in. .env.local is never committed.
# EXPO_PUBLIC_* values are bundled into the app; everything else is for scripts only.

# Convex (filled by `pnpm convex:dev`)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Admin key for scripts/uploadStory.ts -> admin.upsertStory (also set in the Convex dashboard)
CONVEX_ADMIN_KEY=

# Cloudflare R2 (scripts only, never in the app)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# RevenueCat (Phase 7)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Server only (Convex dashboard): REVENUECAT_WEBHOOK_AUTH_HEADER

# AdMob unit IDs (Phase 7; app IDs go in app.config.ts)
EXPO_PUBLIC_ADMOB_PREROLL_IOS=
EXPO_PUBLIC_ADMOB_PREROLL_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=

# Resend (server only, Convex dashboard): RESEND_API_KEY, RESEND_FROM_EMAIL

# Sharing
EXPO_PUBLIC_SHARE_URL=
