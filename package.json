{
  "name": "atlas-tales-app",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "pnpm test:app && pnpm test:server",
    "test:app": "jest",
    "test:server": "vitest run",
    "convex:dev": "convex dev",
    "story:fixture": "tsx scripts/makeFixtureStory.ts",
    "story:validate": "tsx scripts/validateStory.ts",
    "story:upload": "node --env-file=.env.local --import tsx scripts/uploadStory.ts",
    "start:dev": "expo start --dev-client",
    "story:narrate": "node --env-file=.env.local --import tsx scripts/narrateStory.ts"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/baloo-bhaijaan-2": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "convex": "^1.50.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "convex-test": "^0.0.71",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "music-metadata": "^12.7.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
